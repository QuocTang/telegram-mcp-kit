# Required
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Default chat (optional — if set, chat_id can be omitted in tool calls)
TELEGRAM_CHAT_ID=your-chat-id-here

# MCP Server (optional)
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_TRANSPORT=stdio   # or streamable-http

# HTTP Client (optional)
# HTTP_TIMEOUT=30.0

# Safety (optional; defaults keep the previous behaviour)
# TELEGRAM_ALLOWED_CHATS=123456789,@mychannel
# TELEGRAM_READ_ONLY=false
# TELEGRAM_DRY_RUN=false
# TELEGRAM_UPLOAD_DIRS=/home/me/reports
# TELEGRAM_WRAP_UPDATES=false
# TELEGRAM_CONFIRM_DESTRUCTIVE=auto
# TELEGRAM_APPROVER_IDS=123456789

# Rate limiting (optional)
# TELEGRAM_MAX_RETRIES=3
# TELEGRAM_MAX_RETRY_WAIT=60
# TELEGRAM_CHAT_INTERVAL=0
# TELEGRAM_GLOBAL_INTERVAL=0
